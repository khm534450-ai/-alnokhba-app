package com.alnokhba.app.data.local

import androidx.room.Dao
import androidx.room.Delete
import androidx.room.Insert
import androidx.room.OnConflictStrategy
import androidx.room.Query
import kotlinx.coroutines.flow.Flow

@Dao
interface StudyItemDao {

    @Query("""
        SELECT * FROM study_items
        WHERE subjectId = :subjectId
        AND sectionId = :sectionId
        ORDER BY updatedAt DESC
    """)
    fun getItems(
        subjectId: String,
        sectionId: String
    ): Flow<List<StudyItemEntity>>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun save(item: StudyItemEntity)

    @Delete
    suspend fun delete(item: StudyItemEntity)

    @Query("DELETE FROM study_items WHERE id = :id")
    suspend fun deleteById(id: String)

    @Query("SELECT COUNT(*) FROM study_items")
    suspend fun getCount(): Int
}
package com.alnokhba.app.data.local

import android.content.Context
import androidx.room.Database
import androidx.room.Room
import androidx.room.RoomDatabase

@Database(
    entities = [StudyItemEntity::class],
    version = 1,
    exportSchema = false
)
abstract class NokhbaDatabase : RoomDatabase() {

    abstract fun studyItemDao(): StudyItemDao

    companion object {
        @Volatile
        private var INSTANCE: NokhbaDatabase? = null

        fun getDatabase(context: Context): NokhbaDatabase {
            return INSTANCE ?: synchronized(this) {
                INSTANCE ?: Room.databaseBuilder(
                    context.applicationContext,
                    NokhbaDatabase::class.java,
                    "alnokhba_database"
                ).build().also {
                    INSTANCE = it
                }
            }
        }
    }
}
package com.alnokhba.app.data

import com.alnokhba.app.data.local.StudyItemDao
import com.alnokhba.app.data.local.StudyItemEntity

class StudyRepository(
    private val dao: StudyItemDao
) {

    fun getItems(
        subjectId: String,
        sectionId: String
    ) = dao.getItems(subjectId, sectionId)

    suspend fun save(item: StudyItemEntity) {
        dao.save(item.copy(updatedAt = System.currentTimeMillis()))
    }

    suspend fun delete(item: StudyItemEntity) {
        dao.delete(item)
    }

    suspend fun getCount(): Int {
        return dao.getCount()
    }
}
