            LazyColumn(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(padding),
                contentPadding = PaddingValues(16.dp),
                verticalArrangement = Arrangement.spacedBy(10.dp)
            ) {
                items(itemsList, key = { it.id }) { item ->
                    Card(
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Column(
                            modifier = Modifier.padding(16.dp)
                        ) {
                            Text(
                                text = item.title,
                                style = MaterialTheme.typography.titleMedium
                            )

                            if (item.description.isNotBlank()) {
                                Spacer(Modifier.height(6.dp))
                                Text(item.description)
                            }

                            Row {
                                TextButton(
                                    onClick = {
                                        editingItem = item
                                        title = item.title
                                        description = item.description
                                        showDialog = true
                                    }
                                ) {
                                    Text("تعديل")
                                }

                                TextButton(
                                    onClick = {
                                        itemsList = itemsList.filterNot {
                                            it.id == item.id
                                        }
                                    }
                                ) {
                                    Text("حذف")
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (showDialog) {
        AlertDialog(
            onDismissRequest = { showDialog = false },
            title = {
                Text(if (editingItem == null) "إضافة عنصر" else "تعديل العنصر")
            },
            text = {
                Column {
                    OutlinedTextField(
                        value = title,
                        onValueChange = { title = it },
                        label = { Text("العنوان") },
                        singleLine = true
                    )

                    Spacer(Modifier.height(8.dp))

                    OutlinedTextField(
                        value = description,
                        onValueChange = { description = it },
                        label = { Text("الوصف أو الملاحظات") },
                        minLines = 3
                    )
                }
            },
            confirmButton = {
                TextButton(
                    onClick = {
                        if (title.isNotBlank()) {
                            val old = editingItem

                            if (old == null) {
                                itemsList = itemsList + StudyItem(
                                    id = UUID.randomUUID().toString(),
                                    subjectId = subjectId,
                                    sectionId = sectionId,
                                    title = title.trim(),
                                    description = description.trim()
                                )
                            } else {
                                itemsList = itemsList.map {
                                    if (it.id == old.id) {
                                        old.copy(
                                            title = title.trim(),
                                            description = description.trim()
                                        )
                                    } else it
                                }
                            }

                            showDialog = false
                        }
                    }
                ) {
                    Text("حفظ")
                }
            },
            dismissButton = {
                TextButton(onClick = { showDialog = false }) {
                    Text("إلغاء")
                }
            }
        )
    }
}
