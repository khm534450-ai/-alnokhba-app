@Composable
fun SectionNavigation() {

    var selectedSubjectId by remember {
        mutableStateOf<String?>(null)
    }

    var selectedSectionId by remember {
        mutableStateOf<String?>(null)
    }

    val subject = SchoolSubjects.all.find {
        it.id == selectedSubjectId
    }

    val section = StudySections.all.find {
        it.id == selectedSectionId
    }

    when {
        subject == null -> {
            SubjectsScreen(
                onSubjectClick = {
                    selectedSubjectId = it
                }
            )
        }

        section == null -> {
            SubjectSectionsScreen(
                subject = subject,
                onBack = {
                    selectedSubjectId = null
                },
                onSectionClick = {
                    selectedSectionId = it
                }
            )
        }

        else -> {
            StudyItemScreen(
                subjectId = subject.id,
                sectionId = section.id,
                sectionTitle = "${subject.name} - ${section.title}",
                onBack = {
                    selectedSectionId = null
                }
            )
        }
    }
}
