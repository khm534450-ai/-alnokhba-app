box.innerHTML=`<div class="card"><h2>${currentSubject} - ملاحظاتي</h2>
<textarea class="field" id="notes" placeholder="اكتب ملاحظاتك..."></textarea>
<button class="primary" onclick="saveNotes()">حفظ الملاحظات</button></div>`;
document.getElementById("notes").value=localStorage.getItem("notes_"+currentSubject)||"";
return;
}
if(name==="الملفات وPDF"){
box.innerHTML=`<div class="card"><h2>ملفات ${currentSubject}</h2>
<input class="field" type="file" accept=".pdf" multiple>
<p class="notice">رفع الملفات وتحليلها يحتاج ربط خدمة تخزين ومعالجة PDF.</p></div>`;
return;
}
box.innerHTML=`<div class="card"><h2>${currentSubject} - ${name}</h2>
<p>هذا القسم مخصص لمحتوى ${name} في مادة ${currentSubject}.</p></div>`;
}
function saveNotes(){
localStorage.setItem("notes_"+currentSubject,document.getElementById("notes").value);
alert("تم حفظ الملاحظات.");
}
function goHome(){
document.querySelectorAll(".detail").forEach(x=>x.classList.remove("active"));
