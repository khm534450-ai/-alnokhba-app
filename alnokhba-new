}
function toggleTheme(){
document.body.classList.toggle("dark");
localStorage.setItem("nok_theme",document.body.classList.contains("dark")?"dark":"light");
}

/* تحويل الفيديو إلى نص - يتطلب خادماً خلفياً */
async function transcribeVideo(){
const url=document.getElementById("videoUrl").value.trim();
const language=document.getElementById("videoLanguage").value;
const status=document.getElementById("videoStatus");
const output=document.getElementById("videoOutput");
const btn=document.getElementById("transcribeBtn");

if(!url){
alert("ضع رابط الفيديو أولاً.");
return;
}
try{
new URL(url);
}catch(e){
alert("الرابط غير صحيح.");
return;
}

btn.disabled=true;
status.textContent="جارٍ إرسال الرابط للمعالجة...";
output.innerHTML="";

try{
const response=await fetch("/api/video-to-text",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({url:url,language:language})
});
if(!response.ok)throw new Error("الخدمة غير متاحة حالياً.");
const result=await response.json();

if(!result.transcript)throw new Error("لم يتم إرجاع النص.");

const title=document.createElement("h3");
title.textContent="النص المستخرج من الفيديو";
const transcript=document.createElement("div");
transcript.className="video-result";
transcript.textContent=result.transcript;

const summaryTitle=document.createElement("h3");
summaryTitle.textContent="الملخص الشامل";
const summary=document.createElement("div");
summary.className="video-result";
summary.textContent=result.summary||"لم يتم توفير ملخص.";

output.append(title,transcript,summaryTitle,summary);
status.textContent="اكتملت معالجة الفيديو.";
}catch(error){
status.textContent="لم تكتمل المعالجة: "+error.message;
output.innerHTML='<p class="notice">ميزة تحويل الفيديو تحتاج إلى إنشاء وربط الخادم الخلفي وخدمة التعرف على الكلام. هذه الواجهة وحدها لا تستطيع استخراج صوت الفيديو من الرابط.</p>';
}finally{
btn.disabled=false;
}
}

/* تشغيل أولي */
if(localStorage.getItem("nok_theme")==="dark"){
document.body.classList.add("dark");
}
document.getElementById("examDate").value=localStorage.getItem("nok_exam")||"";
renderSubjects();
renderTasks();
updateCounters();
updateExam();
setInterval(updateCounters,1000);
setInterval(updateExam,60000);
</script>
